{
  "name": "@infoprice/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/server/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "usuario": "tsx src/scripts/usuario.ts",
    "gerar-fixtures": "tsx src/scripts/gerar-fixtures.ts",
    "baixar-fontes": "tsx src/scripts/baixar-fontes.ts",
    "baixar-ca-rds": "tsx src/scripts/baixar-ca-rds.ts",
    "testar-conexao": "tsx src/scripts/testar-conexao.ts"
  },
  "dependencies": {
    "@infoprice/shared": "*",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.6",
    "ssh2-sftp-client": "^12.0.0",
    "tar-stream": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/ssh2-sftp-client": "^9.0.4",
    "@types/tar-stream": "^3.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
