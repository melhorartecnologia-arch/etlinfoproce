# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Autenticação ────────────────────────────────────────────────────────────
# Duração da sessão. Ao expirar, a tela volta para o login.
SESSAO_DURACAO_HORAS=12
# Falhas de login por usuário na janela abaixo antes de travar.
# O limite por IP é quatro vezes este, para não punir um escritório inteiro.
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MIN=15
# Marque o cookie como Secure. Obrigatório em produção (HTTPS); em
# desenvolvimento sobre http://localhost o navegador recusaria o cookie.
COOKIE_SEGURO=false

# ── PostgreSQL de destino ───────────────────────────────────────────────────
# Em RDS use o endpoint do writer, não o do reader: a aplicação escreve.
# Com Multi-AZ, o endpoint do writer segue a instância ativa no failover.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=dw_precos
PGUSER=infoprice
PGSCHEMA=infoprice
# Rótulo apenas informativo, exibido na tela de configuração
INSTANCIA_ROTULO=postgres.interno:5432
PGPOOL_MAX=10

# ── TLS ─────────────────────────────────────────────────────────────────────
# verify-full  cifra e confere certificado e hostname (correto para RDS)
# require      cifra sem conferir o certificado (não protege de interceptação)
# disable      sem TLS (só para PostgreSQL local)
# O padrão é verify-full quando PGHOST termina em .rds.amazonaws.com.
PGSSLMODE=disable
# Bundle de CAs do RDS. Baixe com: npm run baixar-ca-rds
CA_RDS=./certs/rds-global-bundle.pem

# ── Credencial do banco ─────────────────────────────────────────────────────
# env             usa PGPASSWORD abaixo
# secrets-manager lê a senha de um segredo do AWS Secrets Manager
# iam             token IAM de 15 min, renovado a cada conexão (sem senha fixa)
PG_CREDENCIAL=env
PGPASSWORD=infoprice
PG_SEGREDO_ARN=
AWS_REGION=sa-east-1

# ── Tempos do banco ─────────────────────────────────────────────────────────
PG_TIMEOUT_CONEXAO_MS=10000
PG_TIMEOUT_OCIOSA_MS=30000
# Teto das consultas de tela.
PG_TIMEOUT_CONSULTA_MS=30000
# Teto das etapas pesadas da ingestão (COPY, regras, merge).
PG_TIMEOUT_INGESTAO_MS=3600000
# Derruba sessão parada dentro de transação, para não segurar locks no RDS.
PG_TIMEOUT_TRANSACAO_OCIOSA_MS=120000

# ── Origem SFTP ─────────────────────────────────────────────────────────────
# driver=sftp usa o servidor real; driver=local lê de SFTP_DIRETORIO_LOCAL
SFTP_DRIVER=local
SFTP_HOST=sftp.exemplo.com.br
SFTP_PORT=22
SFTP_USUARIO=usuario-sftp
# Caminho para a chave privada .pem. NUNCA versione a chave no repositório.
SFTP_CHAVE_PRIVADA=./secrets/chave-sftp.pem
SFTP_CHAVE_PASSPHRASE=
# Alternativa à chave: senha vinda do cofre de segredos.
# Prefira a chave; a senha existe só para compatibilidade.
SFTP_SENHA=
SFTP_DIRETORIO_BASE=/home/usuario-sftp/output/ISA-InfoPanel
SFTP_TIMEOUT_MS=30000
# Diretório usado quando SFTP_DRIVER=local
SFTP_DIRETORIO_LOCAL=./var/sftp-local/output/ISA-InfoPanel

# ── Coleta ──────────────────────────────────────────────────────────────────
AREA_TEMPORARIA=./var/spool/infoprice
DOWNLOAD_PARALELISMO=4
RETENCAO_ORIGEM_DIAS=5
RETENCAO_LOCAL_DIAS=30
COLUNAS_ESPERADAS=42
FONTE=ISA-InfoPanel

# ── Agendamento ─────────────────────────────────────────────────────────────
AGENDAMENTO_ATIVO=true
CRON_COLETA=30 5 * * *
CRON_VARREDURA=0 12,18 * * *
CRON_RESUMO=0 6 * * *
TIMEZONE=America/Sao_Paulo
TENTATIVAS=3
ESPERA_TENTATIVAS_MIN=10,20,40
TOLERANCIA_ATE=09:00
DESVIO_VOLUME_PCT=25
LIMITE_REJEICOES_PCT=0.5

# ── Alertas ─────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=console-ingestao@infoprice.local
ALERTA_DESTINATARIOS=equipe-dados@exemplo.com.br
RESUMO_DESTINATARIOS=equipe-dados@exemplo.com.br,bi@exemplo.com.br
